    "checkpoints": false
  },
  "common": {
    "batch": 2048,
    "ubatch": 1024,
    "kv": "f16",
    "indirect_dispatch": false,
    "row_lists": true
  },
  "order": "correctness, server off/on, synthetic off/on, server on/off"
