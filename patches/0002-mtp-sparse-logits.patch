diff --git a/tests/test-mtp-hidden.cpp b/tests/test-mtp-hidden.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-mtp-hidden.cpp
@@ -0,0 +1,201 @@
+// Model-backed regression test: all MTP hidden rows with sparse target logits.
+// Usage: test-mtp-hidden model.gguf prompt-tokens.json
+#include "llama.h"
+#include "../src/llama-ext.h"
+#include "../vendor/nlohmann/json.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool ok, const char * message) {
+    if (!ok) { throw std::runtime_error(message); }
+}
+
+static void compare(const char * name, const std::vector<float> & ref, const float * got, double tolerance) {
+    require(got != nullptr, "missing output");
+    double error = 0, norm = 0, max_abs = 0;
+    for (size_t i = 0; i < ref.size(); ++i) {
+        require(std::isfinite(ref[i]) && std::isfinite(got[i]), "nonfinite output");
+        const double delta = (double) ref[i] - got[i];
+        error += delta * delta;
+        norm += (double) ref[i] * ref[i];
+        max_abs = std::max(max_abs, std::abs(delta));
+    }
+    const double nrmse = std::sqrt(error / std::max(norm, 1e-30));
+    std::printf("%s: elements=%zu nrmse=%.9g max_abs=%.9g\n", name, ref.size(), nrmse, max_abs);
+    require(nrmse <= tolerance, "output mismatch");
+}
+
+struct token_row { llama_token token; llama_pos pos; llama_seq_id seq; bool output; };
+
+static void check_batch(llama_context * ref, llama_context * opt, llama_context * ordinary, const char * label,
+                        const std::vector<token_row> & rows, int hidden, int vocab) {
+    std::printf("CASE %s (%zu tokens)\n", label, rows.size());
+    auto batch = llama_batch_init((int) rows.size(), 0, 1);
+    batch.n_tokens = rows.size();
+    for (size_t i = 0; i < rows.size(); ++i) {
+        batch.token[i] = rows[i].token;
+        batch.pos[i] = rows[i].pos;
+        batch.n_seq_id[i] = 1;
+        batch.seq_id[i][0] = rows[i].seq;
+        batch.logits[i] = true;
+    }
+    require(llama_decode(ref, batch) == 0, "reference decode failed");
+    const float * h = llama_get_embeddings_pre_norm(ref);
+    require(h != nullptr, "reference hidden state missing");
+    const std::vector<float> ref_hidden(h, h + rows.size()*hidden);
+    std::vector<std::vector<float>> ref_logits(rows.size());
+    for (size_t i = 0; i < rows.size(); ++i) {
+        if (rows[i].output) {
+            const float * logits = llama_get_logits_ith(ref, i);
+            require(logits != nullptr, "reference logits missing");
+            ref_logits[i].assign(logits, logits + vocab);
+        }
+        batch.logits[i] = rows[i].output;
+    }
+    // The normal, non-MTP output path is the logits oracle. Reducing the
+    // number of requested rows selects a different existing Vulkan GEMM/GEMV
+    // kernel than the all-output reference used for hidden-state validation.
+    std::vector<std::vector<float>> ordinary_logits(rows.size());
+    // Decode each sequence independently, matching the existing MTP schedule
+    // without enabling hidden-state capture in this reference context.
+    for (llama_seq_id seq : {0, 1}) {
+        std::vector<size_t> indices;
+        for (size_t i = 0; i < rows.size(); ++i) {
+            if (rows[i].seq == seq) { indices.push_back(i); }
+        }
+        if (indices.empty()) { continue; }
+        auto one = llama_batch_init(indices.size(), 0, 1);
+        one.n_tokens = indices.size();
+        for (size_t j = 0; j < indices.size(); ++j) {
+            const auto & row = rows[indices[j]];
+            one.token[j] = row.token;
+            one.pos[j] = row.pos;
+            one.n_seq_id[j] = 1;
+            one.seq_id[j][0] = row.seq;
+            one.logits[j] = row.output;
+        }
+        require(llama_decode(ordinary, one) == 0, "ordinary decode failed");
+        for (size_t j = 0; j < indices.size(); ++j) {
+            const size_t i = indices[j];
+            if (rows[i].output) {
+                const float * logits = llama_get_logits_ith(ordinary, j);
+                require(logits != nullptr, "ordinary logits missing");
+                ordinary_logits[i].assign(logits, logits + vocab);
+            }
+        }
+        llama_batch_free(one);
+    }
+    require(llama_decode(opt, batch) == 0, "sparse decode failed");
+    compare("hidden", ref_hidden, llama_get_embeddings_pre_norm(opt), 2e-5);
+    for (size_t i = 0; i < rows.size(); ++i) {
+        if (rows[i].output) {
+            const float * logits = llama_get_logits_ith(opt, i);
+            compare("all-output-vs-sparse-kernel (diagnostic)", ref_logits[i], logits,
+                    std::numeric_limits<double>::infinity());
+            compare("ordinary-vs-MTP-sparse-logits", ordinary_logits[i], logits, 1e-6);
+            const auto expected = std::max_element(ordinary_logits[i].begin(), ordinary_logits[i].end()) - ordinary_logits[i].begin();
+            const auto actual = std::max_element(logits, logits + vocab) - logits;
+            require(expected == actual, "greedy token changed");
+        }
+    }
+    llama_batch_free(batch);
+    std::fflush(stdout);
+}
+
+static std::vector<uint8_t> checkpoint(llama_context * ctx) {
+    std::vector<uint8_t> state(llama_state_seq_get_size(ctx, 0));
+    require(llama_state_seq_get_data(ctx, state.data(), state.size(), 0) == state.size(), "checkpoint save failed");
+    return state;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        require(argc == 3, "usage: test-mtp-hidden model.gguf prompt-tokens.json");
+        std::ifstream input(argv[2]);
+        nlohmann::json json;
+        input >> json;
+        const auto tokens = json.get<std::vector<llama_token>>();
+        require(tokens.size() >= 4096, "need at least 4096 input tokens");
+        llama_backend_init();
+        auto mp = llama_model_default_params();
+        mp.n_gpu_layers = 999;
+        mp.use_mmap = false;
+        llama_model * model = llama_model_load_from_file(argv[1], mp);
+        require(model != nullptr, "model load failed");
+        auto cp = llama_context_default_params();
+        cp.n_ctx = 8192;
+        cp.n_batch = 2048;
+        cp.n_ubatch = 1024;
+        cp.n_seq_max = 2;
+        cp.kv_unified = true;
+        cp.n_threads = cp.n_threads_batch = 16;
+        cp.type_k = cp.type_v = GGML_TYPE_F16;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+        llama_context * ref = llama_init_from_model(model, cp);
+        llama_context * opt = llama_init_from_model(model, cp);
+        llama_context * ordinary = llama_init_from_model(model, cp);
+        require(ref && opt && ordinary, "context load failed");
+        llama_set_embeddings(ref, true);
+        llama_set_embeddings_pre_norm(ref, true, true);
+        llama_set_embeddings(opt, false);
+        llama_set_embeddings_pre_norm(opt, true, false);
+        const int hidden = llama_model_n_embd(model);
+        const int vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+        auto single = [&](int start, int count, bool every_output) {
+            std::vector<token_row> rows;
+            for (int i = 0; i < count; ++i) {
+                rows.push_back({ tokens[start+i], start+i, 0, every_output });
+            }
+            return rows;
+        };
+        check_batch(ref, opt, ordinary, "zero-logit-prefill-two-ubatches", single(0, 2048, false), hidden, vocab);
+        auto tail = single(2048, 17, false);
+        tail.back().output = true;
+        check_batch(ref, opt, ordinary, "partial-tail-last-logit", tail, hidden, vocab);
+        const auto ref_state = checkpoint(ref), opt_state = checkpoint(opt);
+        const auto ordinary_state = checkpoint(ordinary);
+        const auto verify = single(2065, 7, true);
+        check_batch(ref, opt, ordinary, "speculative-verification", verify, hidden, vocab);
+        require(llama_state_seq_set_data(ref, ref_state.data(), ref_state.size(), 0) == ref_state.size(), "reference restore failed");
+        require(llama_state_seq_set_data(opt, opt_state.data(), opt_state.size(), 0) == opt_state.size(), "sparse restore failed");
+        require(llama_state_seq_set_data(ordinary, ordinary_state.data(), ordinary_state.size(), 0) == ordinary_state.size(), "ordinary restore failed");
+        check_batch(ref, opt, ordinary, "verification-after-checkpoint-restore", verify, hidden, vocab);
+        llama_memory_clear(llama_get_memory(ref), true);
+        llama_memory_clear(llama_get_memory(opt), true);
+        llama_memory_clear(llama_get_memory(ordinary), true);
+        std::vector<token_row> mixed;
+        for (int i = 0; i < 800; ++i) { mixed.push_back({ tokens[i], i, 0, i == 799 }); }
+        for (int i = 0; i < 900; ++i) { mixed.push_back({ tokens[1024+i], i, 1, i == 899 }); }
+        check_batch(ref, opt, ordinary, "two-unequal-sequences", mixed, hidden, vocab);
+        mixed.clear();
+        for (int i = 0; i < 5; ++i) { mixed.push_back({ tokens[800+i], 800+i, 0, true }); }
+        for (int i = 0; i < 7; ++i) { mixed.push_back({ tokens[1924+i], 900+i, 1, true }); }
+        check_batch(ref, opt, ordinary, "two-sequence-verification", mixed, hidden, vocab);
+        llama_memory_clear(llama_get_memory(ref), true);
+        llama_memory_clear(llama_get_memory(opt), true);
+        llama_memory_clear(llama_get_memory(ordinary), true);
+        mixed.clear();
+        for (int i = 0; i < 129; ++i) {
+            mixed.push_back({ tokens[i], i, 0, i == 128 });
+            mixed.push_back({ tokens[1024+i], i, 1, i == 128 });
+        }
+        check_batch(ref, opt, ordinary, "interleaved-input-hidden-row-order", mixed, hidden, vocab);
+        llama_free(ordinary);
+        llama_free(opt);
+        llama_free(ref);
+        llama_model_free(model);
+        llama_backend_free();
+        std::puts("PASS: hidden states, sparse logits, verification and checkpoint restore");
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "FAIL: %s\n", e.what());
+        return 1;
+    }
+}
