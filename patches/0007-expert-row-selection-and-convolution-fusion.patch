+// Opt-in four-tap recurrent convolution fusion, preserving the original fallback.
+static bool ggml_vk_can_fuse_conv_concat_silu(ggml_backend_vk_context * ctx, const ggml_cgraph * graph, int i) {
+    static const bool enabled = [] { const char *e=getenv("GGML_VK_SSM_CONV_FUSED"); return e && atoi(e)!=0; }();
+    if (!enabled || i+2>=graph->n_nodes ||
+        !ggml_can_fuse_subgraph(graph, i, {GGML_OP_CONCAT, GGML_OP_SSM_CONV, GGML_OP_UNARY}, {i+2})) return false;
+    const auto * concat=graph->nodes[i];
+    const auto * conv=graph->nodes[i+1];
+    const auto * dst=graph->nodes[i+2];
+    if (conv->src[0]!=concat || dst->src[0]!=conv || ggml_get_unary_op(dst)!=GGML_UNARY_OP_SILU) return false;
+    const auto * a=concat->src[0]; const auto * b=concat->src[1]; const auto * w=conv->src[1];
+    if (ggml_get_op_params_i32(concat,0)!=0 || a->type!=GGML_TYPE_F32 || b->type!=GGML_TYPE_F32 ||
+        w->type!=GGML_TYPE_F32 || dst->type!=GGML_TYPE_F32 || a->ne[0]!=3 || w->ne[0]!=4 ||
+        b->ne[0]<32 || b->ne[1]<32 || a->ne[3]!=1 || b->ne[3]!=1 ||
+        a->nb[0]!=4 || b->nb[1]!=4 || w->nb[0]!=4 || !ggml_is_contiguous(dst) ||
+        dst->ne[0]!=b->ne[1] || dst->ne[1]!=b->ne[0] || dst->ne[2]!=b->ne[2] ||
+        dst->ne[3]!=1 || dst->ne[0]>32*65535 || dst->ne[1]>32*65535 || dst->ne[2]>65535) return false;
+    for (const auto * t : {a,b,w,dst}) {
+        if (ggml_nbytes(t)>ctx->device->properties.limits.maxStorageBufferRange) return false;
+        for (int d=0; d<4; ++d) if (t->nb[d]%4 || t->nb[d]/4>UINT32_MAX) return false;
+    }
+    return true;
+}
