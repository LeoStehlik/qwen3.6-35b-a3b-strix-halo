+// Exact routing/ownership oracle: one-hot activations select a known FP4 weight.
+// Separate from CPU MUL_MAT_ID, whose Q8 activation staging is not exact.
+#include "ggml.h"
+#include "ggml-backend.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+static void require(bool ok,const char *why) { if (!ok) throw std::runtime_error(why); }
+int main() {
+    ggml_backend_load_all();auto backend=ggml_backend_init_by_name("Vulkan0",nullptr);
+    require(backend,"Vulkan0 unavailable");
+    constexpr int k=2048,m=128,n=145,experts=256,blocks=k/32;
+    const int values[16]={0,1,2,3,4,6,8,10,0,-1,-2,-3,-4,-6,-8,-10};
+    for (int used : {1,8}) for (bool broadcast : {false,true}) {
+        ggml_init_params ip={ggml_tensor_overhead()*16+ggml_graph_overhead(),nullptr,true};
+        auto ctx=ggml_init(ip);
+        auto a=ggml_new_tensor_3d(ctx,GGML_TYPE_Q4_0_ROCMFP4_FAST,k,m,experts);
+        auto b=ggml_new_tensor_3d(ctx,GGML_TYPE_F32,k,broadcast?1:used,n);
+        auto ids=ggml_new_tensor_2d(ctx,GGML_TYPE_I32,used,n);
+        auto out=ggml_mul_mat_id(ctx,a,b,ids);
+        auto graph=ggml_new_graph(ctx);ggml_build_forward_expand(graph,out);
+        auto buffer=ggml_backend_alloc_ctx_tensors(ctx,backend);require(buffer,"allocation");
+        std::vector<uint8_t> packed(ggml_nbytes(a));uint32_t rng=0x12345678;
+        for (size_t block=0;block<packed.size()/17;++block) {
+            for (int j=0;j<16;++j) {rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;packed[block*17+j]=(uint8_t)rng;}
+            packed[block*17+16]=64+(block%16);
+        }
+        std::vector<int32_t> routing(n*used);int counts[experts]={};
+        for (int token=0;token<n;++token) for (int slot=0;slot<used;++slot) {
+            const int active[4]={slot==0?0:2+2*slot,17+3*slot,93+3*slot,slot==0?255:254-2*slot};
+            const int r=(token*37+slot*19)%145;
+            const int e=active[r<1?0:r<33?1:r<81?2:3];routing[token*used+slot]=e;++counts[e];
+        }
+        require(counts[0]==1 && counts[17]==32 && counts[93]==48 && counts[255]==64,"routing fixture");
+        require(counts[1]==0 && counts[254]==0,"zero-expert gaps");
+        std::vector<float> input(ggml_nelements(b),0);
+        const int rows=broadcast?1:used;
+        for (int token=0;token<n;++token) for (int slot=0;slot<rows;++slot) {
+            const int pos=broadcast?token:token*used+slot;
+            input[(token*rows+slot)*k+pos]=1;
+        }
+        std::vector<float> result(ggml_nelements(out),std::numeric_limits<float>::quiet_NaN());
+        ggml_backend_tensor_set(a,packed.data(),0,packed.size());
+        ggml_backend_tensor_set(b,input.data(),0,ggml_nbytes(b));
+        ggml_backend_tensor_set(ids,routing.data(),0,ggml_nbytes(ids));
+        ggml_backend_tensor_set(out,result.data(),0,ggml_nbytes(out));
+        require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"compute");
+        ggml_backend_tensor_get(out,result.data(),0,ggml_nbytes(out));
+        size_t errors=0;uint64_t hash=1469598103934665603ull;
+        for (int token=0;token<n;++token) for (int slot=0;slot<used;++slot) for (int row=0;row<m;++row) {
+            const int e=routing[token*used+slot],pos=broadcast?token:token*used+slot;
+            const size_t offset=((e*m+row)*blocks+pos/32)*17;
+            const uint8_t byte=packed[offset+pos%16];const int code=(pos%32)<16?byte&15:byte>>4;
+            const int sc=packed[offset+16],exp=sc>>3,man=sc&7;
+            const float expected=values[code]*std::ldexp(float(8+man),exp-11);
+            float got=result[(token*used+slot)*m+row];
+            if (!std::isfinite(got) || got!=expected) {
+                if (errors++<4) std::fprintf(stderr,"token=%d slot=%d expert=%d row=%d got=%g expected=%g\n",token,slot,e,row,got,expected);
+            }
+            if (got==0) { got=0; }
+            uint32_t bits;
+            std::memcpy(&bits,&got,4);
+            hash=(hash^bits)*1099511628211ull;
+        }
+        std::printf("used=%d broadcast=%d values=%zu errors=%zu hash=%016llx\n",used,broadcast,result.size(),errors,(unsigned long long)hash);
+        require(errors==0,"row ownership mismatch");
+        ggml_backend_buffer_free(buffer);ggml_free(ctx);
+    }
+    ggml_backend_free(backend);std::puts("PASS: mixed 1/32/48/64 rows, exact ownership, expert boundaries and gaps");
+}
