index 0000000..1f6ef8d
--- /dev/null
+++ b/tests/test-mmid-fp4.cpp
@@ -0,0 +1,62 @@
+// Exhaustive ROCmFP4 FAST decoding through the real Vulkan expert matmul shader.
+// Compare basis-vector products directly, avoiding CPU matmul's Q8 activation staging.
+#include "ggml.h"
+#include "ggml-backend.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+static void check(bool ok,const char *why) { if (!ok) throw std::runtime_error(why); }
+int main() {
+    ggml_backend_load_all();
+    auto backend=ggml_backend_init_by_name("Vulkan0",nullptr);
+    check(backend,"Vulkan0 unavailable");
+    constexpr int m=4096,n=128;
+    const int values[16]={0,1,2,3,4,6,8,10,0,-1,-2,-3,-4,-6,-8,-10};
+    size_t checked=0;
+    for (int k : {32,64}) {
+        ggml_init_params params={ggml_tensor_overhead()*16+ggml_graph_overhead(),nullptr,true};
+        auto ctx=ggml_init(params);check(ctx,"context");
+        auto a=ggml_new_tensor_3d(ctx,GGML_TYPE_Q4_0_ROCMFP4_FAST,k,m,1);
+        auto b=ggml_new_tensor_3d(ctx,GGML_TYPE_F32,k,1,n);
+        auto ids=ggml_new_tensor_2d(ctx,GGML_TYPE_I32,1,n);
+        auto out=ggml_mul_mat_id(ctx,a,b,ids);
+        auto graph=ggml_new_graph(ctx);ggml_build_forward_expand(graph,out);
+        auto buffer=ggml_backend_alloc_ctx_tensors(ctx,backend);check(buffer,"allocation");
+        check(ggml_type_size(a->type)==17 && ggml_blck_size(a->type)==32,"FP4 layout");
+        std::vector<uint8_t> packed(ggml_nbytes(a),0);
+        for (int row=0;row<m;++row) for (int block=0;block<k/32;++block) {
+            const int off=(row*(k/32)+block)*17;
+            for (int j=0;j<16;++j) packed[off+j]=(row%16) | (((j+block)%16)<<4);
+            packed[off+16]=row/16;
+        }
+        std::vector<float> input(k*n,0);
+        for (int token=0;token<n;++token) input[token*k+token%k]=1;
+        std::vector<int32_t> expert(n,0);
+        ggml_backend_tensor_set(a,packed.data(),0,packed.size());
+        ggml_backend_tensor_set(b,input.data(),0,ggml_nbytes(b));
+        ggml_backend_tensor_set(ids,expert.data(),0,ggml_nbytes(ids));
+        check(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"compute");
+        std::vector<float> result(m*n);ggml_backend_tensor_get(out,result.data(),0,ggml_nbytes(out));
+        size_t errors=0;
+        for (int token=0;token<n;++token) for (int row=0;row<m;++row) {
+            const int pos=token%k,block=pos/32,j=pos%32;
+            const int scale_byte=row/16;
+            const int code=j<16?row%16:((j-16+block)%16);
+            const int exp=(scale_byte>>3)&15,man=scale_byte&7;
+            const float scale=scale_byte>=127?0.0f:(exp==0?std::ldexp(float(man),-10):std::ldexp(float(8+man),exp-11));
+            const float expected=values[code]*scale, got=result[token*m+row];
+            if (!std::isfinite(got) || got!=expected) {
+                if (errors++<8) std::fprintf(stderr,"k=%d scale=%d code=%d position=%d got=%.9g expected=%.9g\n",k,scale_byte,code,pos,got,expected);
+            }
+            ++checked;
+        }
+        std::printf("K=%d: %d values, %zu mismatches (all 256 packed bytes x 256 scale bytes)\n",k,m*n,errors);
+        check(errors==0,"decoded value mismatch");
+        ggml_backend_buffer_free(buffer);ggml_free(ctx);
+    }
+    ggml_backend_free(backend);
+    std::printf("PASS: %zu exact output checks\n",checked);
+}
