+static void ggml_vk_conv_concat_silu(ggml_backend_vk_context * ctx, vk_context & subctx,
+                                    const ggml_cgraph * graph, int i) {
+    const auto * a=graph->nodes[i]->src[0]; const auto * b=graph->nodes[i]->src[1];
+    const auto * w=graph->nodes[i+1]->src[1]; const auto * dst=graph->nodes[i+2];
+    // The allocator may recycle an input for the final output. In that case use the
+    // already allocated, elided concat as scratch, then copy after the full dispatch.
+    const bool alias=ggml_vk_tensors_overlap(a,dst,false) || ggml_vk_tensors_overlap(b,dst,false) ||
+                     ggml_vk_tensors_overlap(w,dst,false);
+    const auto * output=alias?graph->nodes[i]:dst;
+    const std::vector<uint32_t> pc = {
+        (uint32_t)dst->ne[0], (uint32_t)dst->ne[1], (uint32_t)dst->ne[2],
+        (uint32_t)(a->nb[1]/4), (uint32_t)(a->nb[2]/4),
+        (uint32_t)(b->nb[0]/4), (uint32_t)(b->nb[2]/4), (uint32_t)(w->nb[1]/4),
+        get_misalign_bytes(ctx,a)/4, get_misalign_bytes(ctx,b)/4,
+        get_misalign_bytes(ctx,w)/4, get_misalign_bytes(ctx,output)/4};
