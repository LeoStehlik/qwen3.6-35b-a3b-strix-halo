diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_concat_silu.comp b/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_concat_silu.comp
new file mode 100644
index 0000000..9f788cc
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/ssm_conv_concat_silu.comp
@@ -0,0 +1,51 @@
+#version 450
+#extension GL_EXT_control_flow_attributes : require
+
+// Four-tap recurrent convolution directly from [history | transposed input].
+// A channel-coalesced tile includes the three history/halo positions and is
+// reused by 32 output tokens. No concatenation or raw-convolution output is stored.
+layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
+layout(binding = 0) readonly buffer A { float history[]; };
+layout(binding = 1) readonly buffer B { float input_data[]; };
+layout(binding = 2) readonly buffer W { float weights[]; };
+layout(binding = 3) writeonly buffer D { float output_data[]; };
+layout(push_constant) uniform Params {
+    uint channels, tokens, sequences;
+    uint history_channel_stride, history_sequence_stride;
+    uint input_token_stride, input_sequence_stride;
+    uint weight_channel_stride;
+    uint history_offset, input_offset, weight_offset, output_offset;
+} p;
+shared float tile[35][33];
+
+void main() {
+    const uint x = gl_LocalInvocationID.x;
+    const uint y = gl_LocalInvocationID.y;
+    const uint c = gl_WorkGroupID.x * 32 + x;
+    const uint t0 = gl_WorkGroupID.y * 32;
+    const uint s = gl_WorkGroupID.z;
+    for (uint row = y; row < 35; row += 8) {
+        const uint t = t0 + row;
+        float value = 0.0;
+        if (c < p.channels && t < p.tokens + 3) {
+            if (t < 3) {
+                value = history[p.history_offset + s*p.history_sequence_stride + c*p.history_channel_stride + t];
+            } else {
+                value = input_data[p.input_offset + s*p.input_sequence_stride + (t-3)*p.input_token_stride + c];
+            }
+        }
+        tile[row][x] = value;
+    }
+    barrier();
+    if (c >= p.channels) return;
+    const uint w = p.weight_offset + c*p.weight_channel_stride;
+    const vec4 coeff = vec4(weights[w], weights[w+1], weights[w+2], weights[w+3]);
+    [[unroll]] for (uint row = y; row < 32; row += 8) {
+        const uint t = t0 + row;
+        if (t < p.tokens) {
+            const vec4 values = vec4(tile[row][x], tile[row+1][x], tile[row+2][x], tile[row+3][x]);
+            const float v = dot(values, coeff);
+            output_data[p.output_offset + (s*p.tokens+t)*p.channels+c] = v/(1.0+exp(-v));
+        }
+    }
+}
