diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/concat_transpose.comp b/ggml/src/ggml-vulkan/vulkan-shaders/concat_transpose.comp
new file mode 100644
index 0000000..93921e5
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/concat_transpose.comp
@@ -0,0 +1,43 @@
+#version 450
+
+// Copy [small history | transposed activations] along dimension 0. Reads
+// activations across channels and writes across tokens through a padded tile.
+// All values are copied as 32-bit words, preserving their bit patterns.
+#include "types.glsl"
+#include "generic_binary_head.glsl"
+
+layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
+shared uint tile[32][33];
+
+void main() {
+    const uint x = gl_LocalInvocationID.x;
+    const uint y = gl_LocalInvocationID.y;
+    const uint t0 = gl_WorkGroupID.x * 32;
+    const uint c0 = gl_WorkGroupID.y * 32;
+    const uint i2 = gl_WorkGroupID.z % p.ne22;
+    const uint i3 = gl_WorkGroupID.z / p.ne22;
+    const uint a0 = get_aoffset() + i2*p.nb02 + i3*p.nb03;
+    const uint b0 = get_boffset() + i2*p.nb12 + i3*p.nb13;
+    const uint d0 = get_doffset() + i2*p.nb22 + i3*p.nb23;
+
+    for (uint j = 0; j < 32; j += 8) {
+        const uint t = t0 + y + j;
+        const uint c = c0 + x;
+        if (t < p.ne20 && c < p.ne21) {
+            if (t < p.ne00) {
+                tile[y+j][x] = data_a[a0 + t*p.nb00 + c*p.nb01];
+            } else {
+                tile[y+j][x] = data_b[b0 + (t-p.ne00)*p.nb10 + c*p.nb11];
+            }
+        }
+    }
+    barrier();
+
+    for (uint j = 0; j < 32; j += 8) {
+        const uint t = t0 + x;
+        const uint c = c0 + y + j;
+        if (t < p.ne20 && c < p.ne21) {
+            data_d[d0 + t*p.nb20 + c*p.nb21] = tile[x][y+j];
+        }
+    }
+}
