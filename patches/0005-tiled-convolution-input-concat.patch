+// Recurrent convolution input: [short state | transposed activation rows].
+// Odd extents, padded planes and non-zero view offsets exercise tile boundaries
+// and descriptor alignment; unsupported shapes/types also cover fallback.
+struct test_concat_transpose : public test_case {
+    const ggml_type type;
+    const int64_t history, tokens, channels, sequences, planes;
+    const bool padded;
+
+    test_concat_transpose(ggml_type type, int64_t history, int64_t tokens,
+                          int64_t channels, int64_t sequences, int64_t planes, bool padded)
+        : type(type), history(history), tokens(tokens), channels(channels),
+          sequences(sequences), planes(planes), padded(padded) {}
+
+    std::string vars() override {
+        return VARS_TO_STR7(type, history, tokens, channels, sequences, planes, padded);
+    }
+    double max_nmse_err() override { return 0.0; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t pad = padded ? 5 : 0;
+        const size_t esz = ggml_type_size(type);
+        auto * state = ggml_new_tensor_4d(ctx, type, history+pad, channels+pad, sequences+pad, planes);
+        auto * input = ggml_new_tensor_4d(ctx, type, channels+pad, tokens+pad, sequences+pad, planes);
+        ggml_set_name(state, "concat_history_storage");
+        ggml_set_name(input, "concat_input_storage");
+        auto * a = ggml_view_4d(ctx, state, history, channels, sequences, planes,
+                state->nb[1], state->nb[2], state->nb[3], padded ? esz : 0);
+        auto * x = ggml_view_4d(ctx, input, channels, tokens, sequences, planes,
+                input->nb[1], input->nb[2], input->nb[3], padded ? esz : 0);
+        return ggml_concat(ctx, a, ggml_transpose(ctx, x), 0);
+    }
+};
